@@ -0,0 +1,23 @@
+import { type BuildOptions } from "@opennextjs/aws/build/helper.js";
+import type { ContentUpdater, Plugin } from "@opennextjs/aws/plugins/content-updater.js";
+import type { NextConfig } from "@opennextjs/aws/types/next-types.js";
+export declare const cacheComponentsSchedulerModule = "__opennext_cache_components_scheduler";
+/**
+ * The flag is `experimental.dynamicIO` in Next.js 15.4, `experimental.cacheComponents` in 15.5 and
+ * `cacheComponents` from 16.0.
+ */
+export declare function isCacheComponentsEnabled(nextConfig: NextConfig): boolean;
+/** Next.js before 16.2 stages its renders with functions that are not covered. */
+export declare function needsCacheComponentsScheduler(buildOpts: BuildOptions, nextConfig: NextConfig): boolean;
+/**
+ * The runner is compiled into the app page runtimes, into the server chunks when the bundler inlines
+ * the runtime, and stays a standalone module for the callers that are not part of a runtime.
+ */
+export declare const runnerFileFilter: RegExp;
+export declare function patchCacheComponents(updater: ContentUpdater, buildOpts: BuildOptions, nextConfig: NextConfig): Plugin;
+export declare function patchRunInSequentialTasks(code: string, filePath: string): string;
+/**
+ * The minifier renames the function and inlines its timer group, but both callees are properties of
+ * an external module and keep their names.
+ */
+export declare const runInSequentialTasksRule = "\nrule:\n  pattern:\n    selector: function_declaration\n    context: \"function $FUNCTION($$$ARGS) { $$$BODY }\"\n  all:\n    - has:\n        regex: DANGEROUSLY_runPendingImmediatesAfterCurrentTask\n        stopBy: end\n    - has:\n        regex: expectNoPendingImmediates\n        stopBy: end\n    - not:\n        has:\n          kind: function_declaration\n          stopBy: end\n          has:\n            regex: DANGEROUSLY_runPendingImmediatesAfterCurrentTask\n            stopBy: end\nfix: |-\n  function $FUNCTION(first, ...rest) {\n    return require(\"__opennext_cache_components_scheduler\").runInSequentialTasks(first, ...rest);\n  }\n";
