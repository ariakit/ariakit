import "#app/styles/global.css";
import "@fontsource-variable/inter";
import {
  Button,
  ButtonLabel,
  ButtonSlot,
} from "@ariakit/ui/components/button.ariakit.react";
import { Nav, NavLink } from "@ariakit/ui/components/nav.ariakit.react";
import {
  Shell,
  ShellFooter,
  ShellEnd,
  ShellStart,
  ShellHeader,
  ShellMain,
  ShellMainBody,
  ShellMainIntro,
  ShellWide,
  ShellSidebar,
  ShellSidebarBody,
  ShellSidebarFooter,
  ShellSidebarHeader,
} from "@ariakit/ui/components/shell.ariakit.react";
import Meta from "#app/components/meta.astro";
import PanelScript from "#app/components/panel-script.astro";
import {
  AppNavigation,
  AppSectionNavigation,
} from "#app/components/app-navigation.react.tsx";
import { AppToc } from "#app/components/app-toc.react.tsx";
import {
  AppThemeOptions,
  AppThemeReset,
} from "#app/components/app-theme-options.react.tsx";
import ThemeScript from "#app/components/theme-script.astro";
import { TooltipButton } from "#app/components/tooltip-button.react.tsx";
import { LogoIcon, Logotype } from "#app/icons/logo.react.tsx";
import type {
  AppExample,
  AppHeading,
  AppLink,
  AppNavigationGroup,
} from "#app/lib/app.ts";
import { getCachedCollection } from "#app/lib/collection-cache.ts";
import { compareNavigationOrder, getGuideDetail } from "#app/lib/content.ts";
import { getEntryExamples } from "#app/lib/gallery.ts";
import { STYLE_GROUPS, STYLES_PATH, getStylePages } from "#app/lib/styles.ts";
import { serializeStructuredData } from "#app/lib/trail.ts";
import {
  APP_DRAWER_ID,
  APP_NAVIGATION_ID,
  APP_TOC_DATA_ID,
  APP_TOP_ID,
  getGalleryIds,
  getLinkPathname,
  isCurrentLink,
  THEME_PANEL_ID,
} from "#app/lib/app.ts";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { Menu, PanelLeft, SwatchBook, X } from "lucide-react";

type Section = "components" | "recipes" | "styles";
// The sections whose pages come from a collection with frameworks.
type EntrySection = Exclude<Section, "styles">;

export interface Props {
  title?: string;
  headings?: AppHeading[];
  /**
   * The preview cards in the `gallery` slot, which the table of contents
   * lists under the examples heading.
   */
  examples?: AppExample[];
  /**
   * The site section of the page. The site navigation lists the pages and
   * guides of this section only. Pages without a section, such as the home
   * page, render no site navigation.
   */
  section?: Section;
  /**
   * Whether the site navigation sidebar renders. Listing pages turn it off to
   * use the full page width. The phone menu still renders.
   * @default true
   */
  sidebar?: boolean;
  /**
   * The text size of the main content. The column follows it. When omitted,
   * `ShellMain` uses its default, `md`.
   */
  size?: "auto" | "lg";
  /**
   * The maximum width of the main content column. Defaults to the column of
   * the text size.
   */
  maxWidth?: string;
}

const {
  title,
  headings = [],
  examples = [],
  section,
  sidebar = true,
  size,
  maxWidth,
} = Astro.props;
const pathname = getLinkPathname(Astro.url.pathname);

// The preview cards in the gallery are headings under the examples heading,
// and the cards find their ids here.
const { examplesId, exampleIds } = getGalleryIds(headings, examples);
Astro.locals.galleryIds = exampleIds;
const exampleHeadings = examples.flatMap((example) => {
  const slug = exampleIds.get(example.previewId);
  if (!slug) return [];
  return { slug, text: example.title, depth: 3 };
});
const tocHeadings = [
  ...(examples.length > 0
    ? [{ slug: examplesId, text: "Examples", depth: 2 }, ...exampleHeadings]
    : []),
  ...headings.filter((heading) => heading.depth <= 3),
];

// The site navigation lists React pages only. Solid pages still build, but
// they are not part of the navigation yet.
const navigationFramework = "react";

const sectionTypes = [
  { type: "components", label: "Components" },
  { type: "styles", label: "Styles" },
  { type: "recipes", label: "Recipes" },
] as const;

const getLink = (href: string, label: string): AppLink => ({
  href,
  label,
  current: isCurrentLink({ href }, pathname),
});

const getEntryHref = (type: EntrySection, id: string) =>
  `/${navigationFramework}/${type}/${id}/`;

// Links of the same category stay together, so the navigation shows them under
// one heading, in the order of the categories.
const getSortedEntries = async (type: EntrySection) => {
  const entries = await getCollection(type, (entry) =>
    entry.data.frameworks.includes(navigationFramework),
  );
  return entries.toSorted((a, b) => compareNavigationOrder(a.data, b.data));
};

// The Styles section documents @ariakit/tailwind, which has no framework, so
// its pages sit under one path for all frameworks.
const getSortedStylePages = async () =>
  getStylePages(await getCollection("styles"));

// A section has no page of its own, so it links to its first page. It is
// current on every page under its path.
const getSectionStart = async (type: Section) => {
  if (type === "styles") {
    const [first] = await getSortedStylePages();
    if (!first) return;
    return { href: first.path, currentPath: STYLES_PATH };
  }
  const [first] = await getSortedEntries(type);
  if (!first) return;
  const href = getEntryHref(type, first.id);
  return { href, currentPath: `/${navigationFramework}/${type}/` };
};

const sections = (
  await Promise.all(
    sectionTypes.map(async ({ type, label }): Promise<AppLink[]> => {
      const start = await getSectionStart(type);
      if (!start) return [];
      const current = isCurrentLink(start, pathname);
      return [{ ...start, label, current }];
    }),
  )
).flat();

// The drawer lists the sections with the entries, where the entry link marks
// the page, so only one link in the menu is the page.
const drawerSections = sections.map((link) => ({ ...link, current: false }));

const getEntryLinks = async (type: EntrySection) => {
  const recipes = await getCachedCollection("recipes");
  const sortedEntries = await getSortedEntries(type);
  return Promise.all(
    sortedEntries.map(async (entry): Promise<AppLink> => {
      const examples = await getEntryExamples({
        entry,
        framework: navigationFramework,
        recipes,
      });
      const href = getEntryHref(type, entry.id);
      const recipe = entry.collection === "recipes" ? entry.data : undefined;
      return {
        ...getLink(href, entry.data.title),
        category: recipe?.category,
        icon: recipe?.icon,
        count: examples.length,
        examples: examples.map((example) => ({
          title: example.title,
          href: example.href,
          previewHref: `/${navigationFramework}/previews/${example.previewId}/`,
          fullscreen: example.fullscreen,
        })),
      };
    }),
  );
};

const getGuideLinks = async (type: EntrySection) => {
  const entries = await getCollection("guides");
  return entries.map(getGuideDetail).flatMap((guide) => {
    if (guide.type !== type) return [];
    if (guide.framework && guide.framework !== navigationFramework) return [];
    return getLink(guide.path, guide.data.title);
  });
};

// The Styles navigation lists its groups in order, guides first.
const getStyleNavigation = async () => {
  const pages = await getSortedStylePages();
  return STYLE_GROUPS.map(({ id, label }): AppNavigationGroup => {
    const links = pages.flatMap((page) => {
      if (page.group !== id) return [];
      return getLink(page.path, page.entry.data.title);
    });
    return { label, links };
  });
};

// The site navigation lists the pages of the current section and its guides.
const getNavigation = async () => {
  if (section === "styles") {
    const groups = await getStyleNavigation();
    return groups.filter((group) => group.links.length > 0);
  }
  const sectionType = sectionTypes.find(({ type }) => type === section);
  if (!sectionType) return [];
  if (sectionType.type === "styles") return [];
  const [entryLinks, guideLinks] = await Promise.all([
    getEntryLinks(sectionType.type),
    getGuideLinks(sectionType.type),
  ]);
  const groups: AppNavigationGroup[] = [
    { label: sectionType.label, links: entryLinks },
    { label: "Guides", links: guideLinks },
  ];
  return groups.filter((group) => group.links.length > 0);
};

const navigation = await getNavigation();
const hasSidebar = sidebar && navigation.length > 0;
// Only the sidebar shows the example card, so the drawer links leave out the
// examples, which would only add to the page size.
const drawerNavigation = navigation.map((group) => ({
  ...group,
  links: group.links.map(({ examples: _examples, ...link }) => link),
}));
---

<!doctype html>
{/* The client router loads the next page without a page animation. The
    navigation islands stay across pages, so their bars travel to the new
    current link. */}
<html lang="en" transition:animate="none">
  <head>
    <slot name="meta"><Meta {title} /></slot>
    <ClientRouter />
    <ThemeScript />
    <script is:inline>
      // Links work while the page parses, before its scripts run. This records
      // the last click until then, so the scripts can do what they would have
      // done for it, such as moving focus to a preview card.
      (() => {
        /** @param {MouseEvent} event */
        const record = (event) => {
          window.appEarlyClick = event;
        };
        document.addEventListener("click", record);
        // Deferred and module scripts run before this event.
        document.addEventListener(
          "DOMContentLoaded",
          () => document.removeEventListener("click", record),
          { once: true },
        );
      })();
    </script>
    <script is:inline>
      // The client router shows the next page in a view transition, which has
      // no animation here. Safari doesn't run the CSS transitions that start
      // in a view transition, such as the travel of a navigation bar, so the
      // router skips it.
      document.addEventListener("astro:before-swap", (event) => {
        const transition = event.viewTransition;
        // A skipped view transition rejects this promise, which no one reads.
        transition.ready.catch(() => {});
        transition.skipTransition();
      });
    </script>
    <script is:inline>
      // The client router takes a link to a place on this page and changes the
      // hash without a hashchange event, which page scripts wait for. The
      // router keeps the history entry, so Back still works after the next
      // page. Its click listener is on the document and changes the hash at
      // once, so a window listener in the same click sends the event after it.
      (() => {
        /** @param {string} url */
        const getPage = (url) => url.split("#")[0];
        /** @type {string | null} */
        let clickURL = null;
        document.addEventListener(
          "click",
          () => {
            clickURL = window.location.href;
          },
          { capture: true },
        );
        window.addEventListener("click", () => {
          const oldURL = clickURL;
          clickURL = null;
          if (oldURL == null) return;
          const newURL = window.location.href;
          if (newURL === oldURL) return;
          if (getPage(newURL) !== getPage(oldURL)) return;
          window.dispatchEvent(
            new HashChangeEvent("hashchange", { oldURL, newURL }),
          );
        });
      })();
    </script>
    <script is:inline>
      // The client router moves the elements that stay to the next page. The
      // move can reset their scroll positions, and always does in Safari, so
      // the scroll positions go back after the move.
      document.addEventListener("astro:before-swap", () => {
        /** @type {Map<Element, { left: number, top: number }>} */
        const scrolls = new Map();
        const selector = "[data-astro-transition-persist] *";
        for (const element of document.querySelectorAll(selector)) {
          const { scrollLeft: left, scrollTop: top } = element;
          if (!left && !top) continue;
          scrolls.set(element, { left, top });
        }
        document.addEventListener(
          "astro:after-swap",
          () => {
            for (const [element, { left, top }] of scrolls) {
              element.scrollTo({ left, top, behavior: "instant" });
            }
          },
          { once: true },
        );
      });
    </script>
  </head>
  <body>
    {/* The outer shell holds the page and a full-height theme panel at the
        end. The panel comes first in the DOM, so its saved state applies
        before the long page content parses. The inner shell holds the
        header, the site navigation, the main content, a table of contents,
        and the footer. */}
    <Shell id={APP_TOP_ID}>
      <ShellSidebar
        id={THEME_PANEL_ID}
        open={false}
        $side="end"
        $width="lg"
        landmark="aside"
        aria-label="Theme"
        className="text-sm"
      >
        <PanelScript />
        <ShellSidebarHeader $p={2} $px={3} className="justify-between">
          <span class="font-medium">Theme</span>
          <Button
            tabIndex={0}
            aria-label="Close theme"
            aria-controls={THEME_PANEL_ID}
            data-shell-close
          >
            <ButtonSlot><X /></ButtonSlot>
          </Button>
        </ShellSidebarHeader>
        <ShellSidebarBody>
          <AppThemeOptions client:load idPrefix={THEME_PANEL_ID} />
        </ShellSidebarBody>
        <ShellSidebarFooter>
          <AppThemeReset client:load />
        </ShellSidebarFooter>
      </ShellSidebar>
      {/* The table of contents comes before the main content, but it starts
          below the intro. It shows once the main body starts, after the intro,
          instead of moving down when the intro arrives. */}
      <Shell className="[&>.shell-sidebar-end:not(:has(~.shell-main>.shell-main-body))]:invisible">
        {/* The navigation island takes the place of the center part, so the
            header keeps the tracks that center it. */}
        <ShellHeader
          $p={2}
          $blur
          className="text-sm grid-cols-[1fr_auto_1fr]! [&>astro-island]:col-2 [&>astro-island]:self-stretch @max-2xl/shell:[&>astro-island]:hidden!"
        >
          {/* The global styles give islands the display of their parent, so a
              hidden button would leave an empty flex item and its gap. */}
          <ShellStart className="[&>astro-island]:contents!">
            {/* Tooltip buttons are islands, which the layout script wires before
                they hydrate. The script restores aria-expanded, so hydration
                ignores that difference. */}
            <TooltipButton
              client:load
              tooltip="Open menu"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls={APP_DRAWER_ID}
              data-shell-toggle
              suppressHydrationWarning
              className="@3xl/shell:hidden"
            >
              <ButtonSlot><Menu /></ButtonSlot>
            </TooltipButton>
            {
              hasSidebar && (
                <TooltipButton
                  client:load
                  tooltip="Toggle navigation"
                  aria-label="Toggle navigation"
                  aria-expanded="true"
                  aria-controls={APP_NAVIGATION_ID}
                  data-shell-toggle
                  suppressHydrationWarning
                  className="@max-3xl/shell:hidden"
                >
                  <ButtonSlot><PanelLeft /></ButtonSlot>
                </TooltipButton>
              )
            }
            <a href="/" aria-label="Ariakit" class="flex items-center gap-2 px-1">
              <LogoIcon size="1.5em" />
              <Logotype size="1.25em" className="@max-xl/shell:hidden" />
            </a>
          </ShellStart>
          {/* The island stays across pages and takes the links of the next
              page, so the bar travels to the new current section. The header
              sizes a navigation in an element directly inside it, so the island
              takes the place of the center part. */}
          <AppSectionNavigation
            client:load
            transition:persist="section-navigation"
            links={sections}
            {pathname}
          />
          <ShellEnd>
            {/* The phone menu holds the theme options below 48rem. A viewport
                query matches the outer shell, which spans the viewport. */}
            {/* The label hides when the open panel narrows the inner shell, so
                the button names itself. The theme buttons don't hydrate, so
                they set the tabindex that Safari needs to focus them on click. */}
            <Button
              tabIndex={0}
              aria-label="Theme"
              aria-expanded="false"
              aria-controls={THEME_PANEL_ID}
              data-shell-toggle
              className="max-md:hidden"
            >
              <ButtonSlot><SwatchBook /></ButtonSlot>
              <ButtonLabel className="@max-lg/shell:hidden">Theme</ButtonLabel>
            </Button>
          </ShellEnd>
        </ShellHeader>
        {/* The theme panel restores its state before the header parses, so
            the header toggles sync with it here instead of at the end of the
            body. Panels after the header sync their own toggles. The client
            router runs the script again for the header of each page. */}
        <script is:inline data-astro-rerun>
          (() => {
            const toggles = document.querySelectorAll("[data-shell-toggle]");
            for (const toggle of toggles) {
              const id = toggle.getAttribute("aria-controls");
              const panel = id ? document.getElementById(id) : null;
              if (!panel) continue;
              const open = panel.hasAttribute("data-open");
              toggle.setAttribute("aria-expanded", String(open));
            }
          })();
        </script>
        {
          hasSidebar && (
            <ShellSidebar
              id={APP_NAVIGATION_ID}
              landmark="nav"
              aria-label="Site"
              className="text-sm"
            >
              <PanelScript />
              {/* The navigation fills the body through its island wrapper,
                  which takes the display of its parent. The wrapper must not
                  grow past the body, so the open group scrolls its links. */}
              <ShellSidebarBody className="flex flex-col [&>astro-island]:min-h-0 [&>astro-island]:flex-1">
                {/* The navigation stays across the pages of a section, which
                    list the same links. */}
                <AppNavigation
                  client:load
                  transition:persist={`site-navigation-${section}`}
                  groups={navigation}
                  {pathname}
                  fill
                />
              </ShellSidebarBody>
            </ShellSidebar>
          )
        }
        {/* Below 48rem, a drawer replaces the sidebar and the header links. */}
        <ShellSidebar
          id={APP_DRAWER_ID}
          open={false}
          $show="max-3xl"
          landmark="nav"
          aria-label="Menu"
          data-shell-transient
          className="text-sm"
        >
          <ShellSidebarHeader $p={2} $px={3} className="justify-between">
            <span class="font-medium">Menu</span>
            <TooltipButton
              client:load
              tooltip="Close menu"
              aria-label="Close menu"
              aria-controls={APP_DRAWER_ID}
              data-shell-close
            >
              <ButtonSlot><X /></ButtonSlot>
            </TooltipButton>
          </ShellSidebarHeader>
          <ShellSidebarBody>
            <AppNavigation
              client:load
              transition:persist={`drawer-navigation-${section ?? "site"}`}
              links={drawerSections}
              groups={drawerNavigation}
              {pathname}
            />
            <div class="grid gap-6 px-3 pt-6 pb-3">
              <span class="ak-ink-70 text-xs font-medium">Theme</span>
              <AppThemeOptions client:load idPrefix={APP_DRAWER_ID} />
            </div>
          </ShellSidebarBody>
        </ShellSidebar>
        {/* The browser can paint a long page before it parses the end.
            Before the main content, the sidebar is in place at the first
            paint, so the content doesn't narrow and shift when it arrives.
            The shell places it in the end column either way. */}
        {
          tocHeadings.length > 0 && (
            <ShellSidebar
              $side="end"
              $from="body"
              $show="6xl"
              $border={false}
              $layer="transparent"
              landmark="nav"
              aria-label="On this page"
              className="text-sm"
            >
              <ShellSidebarBody>
                {/* The island marks the link of the section being read. The
                    server renders the links and the guide before it
                    hydrates. */}
                {/* The island stays across pages, and reads the headings of
                    the page that shows here, before its props come. */}
                <script
                  is:inline
                  type="application/json"
                  id={APP_TOC_DATA_ID}
                  set:html={serializeStructuredData({
                    title,
                    headings: tocHeadings,
                  })}
                />
                <AppToc
                  client:load
                  transition:persist="toc"
                  {title}
                  headings={tocHeadings}
                />
              </ShellSidebarBody>
            </ShellSidebar>
          )
        }
        {/* The gutter stays in rem when main sets its own text size. Firefox
            resolves a variable that reads --spacing() against the parent's
            text, so the gutter would differ between browsers. */}
        <ShellMain
          $size={size}
          $p="var(--app-gutter)"
          $maxWidth={maxWidth}
          className="[--app-gutter:0.875rem] @3xl/shell:[--app-gutter:1.75rem]"
        >
          {/* Page content renders as direct grid items, so preview cards can
              use main bands. */}
          {
            Astro.slots.has("intro") && (
              <ShellMainIntro>
                <slot name="intro" />
              </ShellMainIntro>
            )
          }
          <ShellMainBody className="gap-y-8 pb-16">
            {/* The examples heading is out of the flow, so it doesn't add a
                gap. It sits a little above the gallery, where the table of
                contents scrolls, so it reaches the top of the page before the
                first row of examples and doesn't tie with it. */}
            {
              examples.length > 0 ? (
                <ShellWide className="relative gap-y-[1.75rem]">
                  <h2 id={examplesId} class="sr-only -top-4">
                    Examples
                  </h2>
                  <slot name="gallery" />
                </ShellWide>
              ) : (
                <slot name="gallery" />
              )
            }
            <slot />
          </ShellMainBody>
        </ShellMain>
        <ShellFooter className="text-sm">
          <ShellStart>
            <span class="ak-ink-70">© Ariakit FZ-LLC</span>
          </ShellStart>
          <ShellEnd>
            {/* The Nav doesn't hydrate, so it leaves out the scroll buttons. */}
            <Nav
              $layout="horizontal"
              aria-label="Footer"
              $p="none"
              buttons={false}
            >
              {
                sections.map((link) => (
                  <NavLink href={link.href}>{link.label}</NavLink>
                ))
              }
            </Nav>
          </ShellEnd>
        </ShellFooter>
      </Shell>
    </Shell>
    <script is:inline data-astro-rerun>
      // The shell renders without hydration. Panel scripts restore the saved
      // panel choices earlier. This script syncs the toggles and wires the
      // panels. The client router runs it again for the shell of each page.
      (() => {
        // The document outlives the page, so its listeners go with the page.
        const page = new AbortController();
        document.addEventListener("astro:before-swap", () => page.abort(), {
          once: true,
        });
        /**
         * @param {string} key
         * @param {string | null} value
         */
        const write = (key, value) => {
          try {
            if (value == null) {
              localStorage.removeItem(key);
            } else {
              localStorage.setItem(key, value);
            }
          } catch {}
        };
        // The worker Element type adds an append, so HTMLElement is not a
        // ParentNode. Document and HTMLElement both have querySelectorAll.
        /**
         * @param {Document | HTMLElement} parent
         * @param {string} selector
         */
        const queryAll = (parent, selector) =>
          [...parent.querySelectorAll(selector)].filter(
            (element) => element instanceof HTMLElement,
          );
        /** @param {Element} element */
        const getControlled = (element) => {
          const id = element.getAttribute("aria-controls");
          return id ? document.getElementById(id) : null;
        };

        // Shell panels
        /**
         * @param {HTMLElement} panel
         * @param {boolean} open
         */
        const setOpen = (panel, open) => {
          panel.toggleAttribute("data-open", open);
          const selector = `[data-shell-toggle][aria-controls="${panel.id}"]`;
          const toggles = queryAll(document, selector);
          for (const toggle of toggles) {
            toggle.setAttribute("aria-expanded", String(open));
          }
          // A closing panel hides the focused element when it contains it, so
          // focus moves back to the visible toggle.
          if (!open && panel.contains(document.activeElement)) {
            toggles.find((toggle) => toggle.checkVisibility())?.focus();
          }
          if (panel.hasAttribute("data-shell-transient")) return;
          write(`app-panel:${panel.id}`, String(open));
        };
        document.addEventListener(
          "keydown",
          (event) => {
            if (event.key !== "Escape") return;
            if (event.defaultPrevented) return;
            const selector = "[data-shell-transient][data-open]";
            for (const panel of queryAll(document, selector)) {
              setOpen(panel, false);
            }
          },
          { signal: page.signal },
        );
        for (const toggle of queryAll(document, "[data-shell-toggle]")) {
          const panel = getControlled(toggle);
          if (!panel) continue;
          const open = panel.hasAttribute("data-open");
          toggle.setAttribute("aria-expanded", String(open));
          toggle.addEventListener("click", () => {
            const open = !panel.hasAttribute("data-open");
            setOpen(panel, open);
            // Focus moves to the close button of a panel that its toggle
            // opens.
            if (!open) return;
            queryAll(panel, "[data-shell-close]")[0]?.focus();
          });
        }
        for (const close of queryAll(document, "[data-shell-close]")) {
          const panel = getControlled(close);
          if (!panel) continue;
          close.addEventListener("click", () => setOpen(panel, false));
        }
      })();
    </script>
  </body>
</html>
