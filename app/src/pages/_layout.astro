import "#app/styles/global.css";
import "@fontsource-variable/inter";
import Meta from "#app/components/meta.astro";

export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <slot name="meta"><Meta {title} /></slot>
  </head>
  <body>
    <header>
      <a href="/">Ariakit</a>
      <nav aria-label="Main">
        <ul>
          <li><a href="/astro/previews/ariakit-ui/">Ariakit UI</a></li>
          <li><a href="/react/components/">React components</a></li>
          <li><a href="/solid/components/">Solid components</a></li>
          <li><a href="/react/examples/">Examples</a></li>
        </ul>
      </nav>
    </header>
    <main id="main"><slot /></main>
  </body>
</html>
