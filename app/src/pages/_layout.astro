import "#app/styles/global.css";
import "@fontsource-variable/inter";
import {
  Button,
  ButtonLabel,
  ButtonSlot,
} from "@ariakit/ui/components/button.ariakit.react";
import { Nav, NavLink } from "@ariakit/ui/components/nav.ariakit.react";
import {
  Shell,
  ShellFooter,
  ShellFooterEnd,
  ShellFooterStart,
  ShellHeader,
  ShellHeaderCenter,
  ShellHeaderEnd,
  ShellHeaderStart,
  ShellMain,
  ShellMainBody,
  ShellMainIntro,
  ShellMainWide,
  ShellSidebar,
  ShellSidebarBody,
  ShellSidebarFooter,
  ShellSidebarHeader,
} from "@ariakit/ui/components/shell.ariakit.react";
import Meta from "#app/components/meta.astro";
import PanelScript from "#app/components/panel-script.astro";
import { AppNavigation } from "#app/components/app-navigation.react.tsx";
import { AppToc } from "#app/components/app-toc.react.tsx";
import {
  AppThemeOptions,
  AppThemeReset,
} from "#app/components/app-theme-options.react.tsx";
import ThemeScript from "#app/components/theme-script.astro";
import { TooltipButton } from "#app/components/tooltip-button.react.tsx";
import { LogoIcon, Logotype } from "#app/icons/logo.react.tsx";
import type {
  AppExample,
  AppHeading,
  AppLink,
  AppNavigationGroup,
} from "#app/lib/app.ts";
import { getCachedCollection } from "#app/lib/collection-cache.ts";
import {
  countEntryExamples,
  formatExampleCount,
  getGuideDetail,
} from "#app/lib/content.ts";
import { renderThumbnail } from "#app/lib/thumbnail.ts";
import {
  APP_DRAWER_ID,
  APP_NAVIGATION_ID,
  APP_TOP_ID,
  getUniqueSlug,
  THEME_PANEL_ID,
} from "#app/lib/app.ts";
import { getCollection } from "astro:content";
import { Menu, PanelLeft, SwatchBook, X } from "lucide-react";

type Section = "components" | "recipes";

export interface Props {
  title?: string;
  headings?: AppHeading[];
  /**
   * The preview cards in the `gallery` slot, which the table of contents
   * lists under the examples heading.
   */
  examples?: AppExample[];
  /**
   * The site section of the page. The site navigation lists the pages and
   * guides of this section only. Pages without a section, such as the home
   * page, render no site navigation.
   */
  section?: Section;
  /**
   * Whether the site navigation sidebar renders. Listing pages turn it off to
   * use the full page width. The phone menu still renders.
   * @default true
   */
  sidebar?: boolean;
  /**
   * The maximum width of the main content column.
   * @default "56rem"
   */
  maxWidth?: string;
}

const {
  title,
  headings = [],
  examples = [],
  section,
  sidebar = true,
  maxWidth = "56rem",
} = Astro.props;
// Astro serves routes with and without a trailing slash, and every link ends
// with one.
const pathname = Astro.url.pathname.replace(/\/?$/, "/");

// The preview cards in the gallery are headings under the examples heading.
// Each card id comes from the last segment of its preview id, such as
// `shortcuts` for `tooltip/shortcuts`, and the cards find their ids here.
const slugs = new Set([APP_TOP_ID, ...headings.map((heading) => heading.slug)]);
const examplesSlug = getUniqueSlug(slugs, "examples");
const galleryIds = new Map<string, string>();
const exampleHeadings = examples.map((example) => {
  const segment = example.previewId.split("/").at(-1) ?? example.previewId;
  const slug = getUniqueSlug(slugs, segment);
  galleryIds.set(example.previewId, slug);
  return { slug, text: example.title, depth: 3 };
});
Astro.locals.galleryIds = galleryIds;
const tocHeadings = [
  ...(examples.length > 0
    ? [{ slug: examplesSlug, text: "Examples", depth: 2 }, ...exampleHeadings]
    : []),
  ...headings.filter((heading) => heading.depth <= 3),
];

// The site navigation lists React pages only. Solid pages still build, but
// they are not part of the navigation yet.
const navigationFramework = "react";

const sectionTypes = [
  { type: "components", label: "Components" },
  { type: "recipes", label: "Recipes" },
] as const;

// A link is current on its own page and on nested pages, such as the API
// reference pages of a component.
const getLink = (href: string, label: string): AppLink => ({
  href,
  label,
  current: pathname.startsWith(href),
});

const sections = sectionTypes.map(({ type, label }) =>
  getLink(`/${navigationFramework}/${type}/`, label),
);

// The drawer lists the sections with the entries, so a section is current
// only on its own page there, and only one link in the menu is the page.
const drawerSections = sections.map((link) => ({
  ...link,
  current: link.href === pathname,
}));

const getEntryLinks = async (type: Section) => {
  const recipes = await getCachedCollection("recipes");
  const previews = await getCachedCollection("previews");
  const entries = await getCollection(type, (entry) =>
    entry.data.frameworks.includes(navigationFramework),
  );
  const links = await Promise.all(
    entries.map(async (entry) => {
      const count = countEntryExamples({
        entry,
        framework: navigationFramework,
        recipes,
        previews,
      });
      const href = `/${navigationFramework}/${type}/${entry.id}/`;
      return {
        ...getLink(href, entry.data.title),
        description: formatExampleCount(count),
        thumbnail: await renderThumbnail(entry, "small"),
      };
    }),
  );
  return links.sort((a, b) => a.label.localeCompare(b.label));
};

const getGuideLinks = async (type: Section) => {
  const entries = await getCollection("guides");
  return entries.map(getGuideDetail).flatMap((guide) => {
    if (guide.type !== type) return [];
    if (guide.framework && guide.framework !== navigationFramework) return [];
    return getLink(guide.path, guide.data.title);
  });
};

// The site navigation lists the pages of the current section and its guides.
const getNavigation = async () => {
  const sectionType = sectionTypes.find(({ type }) => type === section);
  if (!sectionType) return [];
  const [entryLinks, guideLinks] = await Promise.all([
    getEntryLinks(sectionType.type),
    getGuideLinks(sectionType.type),
  ]);
  const groups: AppNavigationGroup[] = [
    { label: sectionType.label, links: entryLinks },
    { label: "Guides", links: guideLinks },
  ];
  return groups.filter((group) => group.links.length > 0);
};

const navigation = await getNavigation();
const hasSidebar = sidebar && navigation.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <slot name="meta"><Meta {title} /></slot>
    <ThemeScript />
    <script is:inline>
      // Links work while the page parses, before its scripts run. This records
      // the last click until then, so the scripts can do what they would have
      // done for it, such as moving focus to a preview card.
      (() => {
        /** @param {MouseEvent} event */
        const record = (event) => {
          window.appEarlyClick = event;
        };
        document.addEventListener("click", record);
        // Deferred and module scripts run before this event.
        document.addEventListener(
          "DOMContentLoaded",
          () => document.removeEventListener("click", record),
          { once: true },
        );
      })();
    </script>
    {/* Navigating between site pages moves the navigation bars in a view
        transition. Examples in the page content name their own bars, which
        the next page doesn't have, so page loads leave them out. */}
    <style is:global>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
          types: bar page-load;
        }
      }
      :root:active-view-transition-type(page-load) main .control-bar {
        view-transition-name: none;
      }
    </style>
  </head>
  <body>
    {/* The outer shell holds the page and a full-height theme panel at the
        end. The panel comes first in the DOM, so its saved state applies
        before the long page content parses. The inner shell holds the
        header, the site navigation, the main content, a table of contents,
        and the footer. */}
    <Shell id={APP_TOP_ID}>
      <ShellSidebar
        id={THEME_PANEL_ID}
        open={false}
        $side="end"
        $width="lg"
        landmark="aside"
        aria-label="Theme"
        className="text-sm"
      >
        <PanelScript />
        <ShellSidebarHeader $height="sm" className="justify-between">
          <span class="font-medium">Theme</span>
          <Button
            tabIndex={0}
            aria-label="Close theme"
            aria-controls={THEME_PANEL_ID}
            data-shell-close
          >
            <ButtonSlot><X /></ButtonSlot>
          </Button>
        </ShellSidebarHeader>
        <ShellSidebarBody>
          <AppThemeOptions client:load idPrefix={THEME_PANEL_ID} />
        </ShellSidebarBody>
        <ShellSidebarFooter>
          <AppThemeReset client:load />
        </ShellSidebarFooter>
      </ShellSidebar>
      {/* The table of contents comes before the main content, but it starts
          below the intro. It shows once the main body starts, after the intro,
          instead of moving down when the intro arrives. */}
      <Shell className="[&>.shell-sidebar-end:not(:has(~.shell-main>.shell-main-body))]:invisible">
        <ShellHeader $height="sm" $blur className="text-sm">
          {/* The global styles give islands the display of their parent, so a
              hidden button would leave an empty flex item and its gap. */}
          <ShellHeaderStart className="[&>astro-island]:contents!">
            {/* Tooltip buttons are islands, which the layout script wires before
                they hydrate. The script restores aria-expanded, so hydration
                ignores that difference. */}
            <TooltipButton
              client:load
              tooltip="Open menu"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls={APP_DRAWER_ID}
              data-shell-toggle
              suppressHydrationWarning
              className="@3xl/shell:hidden"
            >
              <ButtonSlot><Menu /></ButtonSlot>
            </TooltipButton>
            {
              hasSidebar && (
                <TooltipButton
                  client:load
                  tooltip="Toggle navigation"
                  aria-label="Toggle navigation"
                  aria-expanded="true"
                  aria-controls={APP_NAVIGATION_ID}
                  data-shell-toggle
                  suppressHydrationWarning
                  className="@max-3xl/shell:hidden"
                >
                  <ButtonSlot><PanelLeft /></ButtonSlot>
                </TooltipButton>
              )
            }
            <a href="/" aria-label="Ariakit" class="flex items-center gap-2 px-1">
              <LogoIcon size="1.5em" />
              <Logotype size="1.25em" className="@max-xl/shell:hidden" />
            </a>
          </ShellHeaderStart>
          <ShellHeaderCenter className="@max-2xl/shell:hidden">
            {/* Astro renders each link apart from the Nav, so the links take the
                bar themselves. */}
            <Nav
              $layout="horizontal"
              aria-label="Main"
              $p="none"
              $barTransitionName="main-nav-bar"
            >
              {
                sections.map((link) => (
                  <NavLink
                    href={link.href}
                    aria-current={link.current ? "page" : undefined}
                    bar
                    text={link.label}
                  />
                ))
              }
            </Nav>
          </ShellHeaderCenter>
          <ShellHeaderEnd>
            {/* The phone menu holds the theme options below 48rem. A viewport
                query matches the outer shell, which spans the viewport. */}
            {/* The label hides when the open panel narrows the inner shell, so
                the button names itself. The theme buttons don't hydrate, so
                they set the tabindex that Safari needs to focus them on click. */}
            <Button
              tabIndex={0}
              aria-label="Theme"
              aria-expanded="false"
              aria-controls={THEME_PANEL_ID}
              data-shell-toggle
              className="max-md:hidden"
            >
              <ButtonSlot><SwatchBook /></ButtonSlot>
              <ButtonLabel className="@max-lg/shell:hidden">Theme</ButtonLabel>
            </Button>
          </ShellHeaderEnd>
        </ShellHeader>
        {/* The theme panel restores its state before the header parses, so
            the header toggles sync with it here instead of at the end of the
            body. Panels after the header sync their own toggles. */}
        <script is:inline>
          (() => {
            const toggles = document.querySelectorAll("[data-shell-toggle]");
            for (const toggle of toggles) {
              const id = toggle.getAttribute("aria-controls");
              const panel = id ? document.getElementById(id) : null;
              if (!panel) continue;
              const open = panel.hasAttribute("data-open");
              toggle.setAttribute("aria-expanded", String(open));
            }
          })();
        </script>
        {
          hasSidebar && (
            <ShellSidebar
              id={APP_NAVIGATION_ID}
              landmark="nav"
              aria-label="Site"
              className="text-sm"
            >
              <PanelScript />
              {/* The navigation fills the body through its island wrapper,
                  which takes the display of its parent. The wrapper must not
                  grow past the body, so the open group scrolls its links. */}
              <ShellSidebarBody className="flex flex-col [&>astro-island]:min-h-0 [&>astro-island]:flex-1">
                <AppNavigation
                  client:load
                  groups={navigation}
                  fill
                  barTransitionName="site-nav-bar"
                />
              </ShellSidebarBody>
            </ShellSidebar>
          )
        }
        {/* Below 48rem, a drawer replaces the sidebar and the header links. */}
        <ShellSidebar
          id={APP_DRAWER_ID}
          open={false}
          $show="max-3xl"
          landmark="nav"
          aria-label="Menu"
          data-shell-transient
          className="text-sm"
        >
          <ShellSidebarHeader $height="sm" className="justify-between">
            <span class="font-medium">Menu</span>
            <TooltipButton
              client:load
              tooltip="Close menu"
              aria-label="Close menu"
              aria-controls={APP_DRAWER_ID}
              data-shell-close
            >
              <ButtonSlot><X /></ButtonSlot>
            </TooltipButton>
          </ShellSidebarHeader>
          <ShellSidebarBody>
            <AppNavigation
              client:load
              links={drawerSections}
              groups={navigation}
              barTransitionName="drawer-nav-bar"
            />
            <div class="grid gap-6 px-3 pt-6 pb-3">
              <span class="ak-ink-70 text-xs font-medium">Theme</span>
              <AppThemeOptions client:load idPrefix={APP_DRAWER_ID} />
            </div>
          </ShellSidebarBody>
        </ShellSidebar>
        {/* The browser can paint a long page before it parses the end.
            Before the main content, the sidebar is in place at the first
            paint, so the content doesn't narrow and shift when it arrives.
            The shell places it in the end column either way. */}
        {
          tocHeadings.length > 0 && (
            <ShellSidebar
              $side="end"
              $from="body"
              $show="6xl"
              $border={false}
              $layer="transparent"
              landmark="nav"
              aria-label="On this page"
              className="text-sm"
            >
              <ShellSidebarBody>
                {/* The island marks the link of the section being read. The
                    server renders the links and the guide before it
                    hydrates. */}
                <AppToc client:load {title} headings={tocHeadings} />
              </ShellSidebarBody>
            </ShellSidebar>
          )
        }
        <ShellMain
          $p="var(--app-gutter)"
          $maxWidth={maxWidth}
          className="[--app-gutter:--spacing(4)] @3xl/shell:[--app-gutter:--spacing(8)]"
        >
          {/* Page content renders as direct grid items, so preview cards can
              use main bands. */}
          {
            Astro.slots.has("intro") && (
              <ShellMainIntro className="gap-y-4">
                <slot name="intro" />
              </ShellMainIntro>
            )
          }
          <ShellMainBody className="gap-y-8">
            {/* The examples heading is out of the flow, so it doesn't add a
                gap. It sits a little above the gallery, where the table of
                contents scrolls, so it reaches the top of the page before the
                first row of examples and doesn't tie with it. */}
            {
              examples.length > 0 ? (
                <ShellMainWide className="relative gap-y-8">
                  <h2 id={examplesSlug} class="sr-only -top-4">
                    Examples
                  </h2>
                  <slot name="gallery" />
                </ShellMainWide>
              ) : (
                <slot name="gallery" />
              )
            }
            <slot />
          </ShellMainBody>
        </ShellMain>
        <ShellFooter className="text-sm">
          <ShellFooterStart>
            <span class="ak-ink-70">© Ariakit FZ-LLC</span>
          </ShellFooterStart>
          <ShellFooterEnd>
            <Nav $layout="horizontal" aria-label="Footer" $p="none">
              {
                sections.map((link) => (
                  <NavLink href={link.href}>{link.label}</NavLink>
                ))
              }
            </Nav>
          </ShellFooterEnd>
        </ShellFooter>
      </Shell>
    </Shell>
    <script is:inline>
      // The shell renders without hydration. Panel scripts restore the saved
      // panel choices earlier. This script syncs the toggles and wires the
      // panels.
      (() => {
        /**
         * @param {string} key
         * @param {string | null} value
         */
        const write = (key, value) => {
          try {
            if (value == null) {
              localStorage.removeItem(key);
            } else {
              localStorage.setItem(key, value);
            }
          } catch {}
        };
        /**
         * @param {ParentNode} parent
         * @param {string} selector
         */
        const queryAll = (parent, selector) =>
          [...parent.querySelectorAll(selector)].filter(
            (element) => element instanceof HTMLElement,
          );
        /** @param {Element} element */
        const getControlled = (element) => {
          const id = element.getAttribute("aria-controls");
          return id ? document.getElementById(id) : null;
        };

        // Shell panels
        /**
         * @param {HTMLElement} panel
         * @param {boolean} open
         */
        const setOpen = (panel, open) => {
          panel.toggleAttribute("data-open", open);
          const selector = `[data-shell-toggle][aria-controls="${panel.id}"]`;
          const toggles = queryAll(document, selector);
          for (const toggle of toggles) {
            toggle.setAttribute("aria-expanded", String(open));
          }
          // A closing panel hides the focused element when it contains it, so
          // focus moves back to the visible toggle.
          if (!open && panel.contains(document.activeElement)) {
            toggles.find((toggle) => toggle.checkVisibility())?.focus();
          }
          if (panel.hasAttribute("data-shell-transient")) return;
          write(`app-panel:${panel.id}`, String(open));
        };
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          if (event.defaultPrevented) return;
          const selector = "[data-shell-transient][data-open]";
          for (const panel of queryAll(document, selector)) {
            setOpen(panel, false);
          }
        });
        for (const toggle of queryAll(document, "[data-shell-toggle]")) {
          const panel = getControlled(toggle);
          if (!panel) continue;
          const open = panel.hasAttribute("data-open");
          toggle.setAttribute("aria-expanded", String(open));
          toggle.addEventListener("click", () => {
            const open = !panel.hasAttribute("data-open");
            setOpen(panel, open);
            // Focus moves to the close button of a panel that its toggle
            // opens.
            if (!open) return;
            queryAll(panel, "[data-shell-close]")[0]?.focus();
          });
        }
        for (const close of queryAll(document, "[data-shell-close]")) {
          const panel = getControlled(close);
          if (!panel) continue;
          close.addEventListener("click", () => setOpen(panel, false));
        }
      })();
    </script>
  </body>
</html>
