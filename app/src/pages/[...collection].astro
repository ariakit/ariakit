import { uniq } from "#app/lib/array.ts";
import { compareNavigationOrder } from "#app/lib/content.ts";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

// The collection pages are gone for now, so each one sends visitors to the
// first entry of its collection in the site navigation.
export const getStaticPaths = (async () => {
  const types = ["components", "recipes"] as const;
  const entries = (
    await Promise.all(types.map((type) => getCollection(type)))
  ).flat();
  const frameworks = uniq(entries.flatMap((entry) => entry.data.frameworks));
  return frameworks.flatMap((framework) =>
    types.flatMap((type) => {
      const [first] = entries
        .filter(
          (entry) =>
            entry.collection === type &&
            entry.data.frameworks.includes(framework),
        )
        .toSorted((a, b) => compareNavigationOrder(a.data, b.data));
      if (!first) return [];
      return {
        params: { collection: `${framework}/${type}` },
        props: { href: `/${framework}/${type}/${first.id}/` },
      };
    }),
  );
}) satisfies GetStaticPaths;

// A static build writes a meta refresh page, which waits two seconds for a 302
// status, and no time for a 307 status.
return Astro.redirect(Astro.props.href, 307);
