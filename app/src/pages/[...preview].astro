import "#app/styles/global.css";
import "@fontsource-variable/inter";
import { isNextjsPreviewId } from "#app/lib/nextjs.ts";
import { getPreviewPaths } from "#app/lib/preview-routes.ts";
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";

export const getStaticPaths = (async () => {
  const entries = await getCollection("previews");
  return entries.flatMap((entry) => {
    // Next.js previews are redirected by the Worker wrapper.
    if (isNextjsPreviewId(entry.id)) return [];
    return getPreviewPaths(entry).map(({ framework, route, path }) => ({
      params: { preview: path },
      props: { framework, route, entry },
    }));
  });
}) satisfies GetStaticPaths;

const { framework, route, entry } = Astro.props;
const { Content } = await render(entry);

Astro.locals.framework = framework;
Astro.locals.previewRoute = route;

// The route is part of the title so a routed preview does not give every one of
// its pages the same document title.
const title = route ? `${entry.data.title}: ${route}` : entry.data.title;
const fullscreen = entry.data.fullscreen;
---

<!doctype html>
<html lang="en" class:list={[!fullscreen && "min-h-[200vh]!"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>Preview {title} - Ariakit</title>
  </head>
  <body
    class:list={[
      "flex",
      !fullscreen && "items-center-safe justify-center-safe",
    ]}
  >
    <div
      class:list={[
        "@container size-full",
        !fullscreen && "p-3 flex items-center-safe justify-center-safe",
      ]}
    >
      <Content {framework} />
    </div>
  </body>
</html>
