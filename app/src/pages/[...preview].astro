import "#app/styles/global.css";
import "@fontsource-variable/inter";
import ThemeScript from "#app/components/theme-script.astro";
import { isNextjsPreviewId } from "#app/lib/nextjs.ts";
import { previewEmbedScript } from "#app/lib/preview-embed.ts";
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";

export const getStaticPaths = (async () => {
  const entries = await getCollection("previews");
  return entries.flatMap((entry) => {
    // Next.js previews are redirected by the Worker wrapper.
    if (isNextjsPreviewId(entry.id)) return [];
    return entry.data.frameworks.map((framework) => ({
      params: { preview: `${framework}/previews/${entry.id}` },
      props: { framework, entry },
    }));
  });
}) satisfies GetStaticPaths;

const { framework, entry } = Astro.props;
const { Content } = await render(entry);

Astro.locals.framework = framework;

const title = entry.data.title;
const fullscreen = entry.data.fullscreen;
// The embed script opens the popup of the preview when a card embeds it.
const open = entry.data.open;
---

<!doctype html>
<html lang="en" data-preview-open={open ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>Preview {title} - Ariakit</title>
    <ThemeScript />
    {/* Runs before the preview renders, so focus calls on mount already
        respect an inactive preview card. */}
    <script is:inline set:html={previewEmbedScript} />
  </head>
  {/* The page leaves room below a short example, so a popup can open below
      its trigger. The body covers that room, so a click there is outside the
      popup, not on the root element that contains it. */}
  <body class:list={["flex", !fullscreen && "min-h-[200vh]! flex-col"]}>
    {/* The framework island wraps the example and sizes to its content, so it
        needs a width limit for the example's own max-w-full to resolve. The
        example stays centered in the first viewport, with the same padding as
        an inline preview card. */}
    <div
      class:list={[
        "@container size-full",
        !fullscreen &&
          "min-h-dvh p-8 flex items-center-safe justify-center-safe *:max-w-full",
      ]}
    >
      <Content {framework} />
    </div>
  </body>
</html>
