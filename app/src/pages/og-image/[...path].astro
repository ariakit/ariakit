import { Logo } from "#app/icons/logo.react.tsx";
import { getFramework } from "#app/lib/framework.ts";
import "#app/styles/global.css";
import "@fontsource-variable/inter";
import { getOGImageItems } from "./api.ts";

export async function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return (await getOGImageItems()).map(({ path, ...props }) => ({
    params: { path },
    props,
  }));
}

const { title, framework, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title ?? "Ariakit"}</title>
  </head>
  <body>
    <div
      data-og-image
      style="width:600px;height:315px;padding:40px;display:flex;flex-direction:column;justify-content:center;gap:16px"
    >
      <Logo />
      {framework && <p>{getFramework(framework).label} {type}</p>}
      {title && <h1>{title}</h1>}
    </div>
  </body>
</html>
