import "./style.css";
import { invariant } from "@ariakit/utils";
import OverviewPage from "./pages/overview.react.tsx";
import HeadingPage from "./pages/heading.react.tsx";
import ProsePage from "./pages/prose.react.tsx";
import SeparatorPage from "./pages/separator.react.tsx";
import CodePage from "./pages/code.react.tsx";
import KbdPage from "./pages/kbd.react.tsx";
import LinkPage from "./pages/link.react.tsx";
import ButtonPage from "./pages/button.react.tsx";
import BadgePage from "./pages/badge.react.tsx";
import InputPage from "./pages/input.react.tsx";
import CheckboxPage from "./pages/checkbox.react.tsx";
import RadioPage from "./pages/radio.react.tsx";
import ComboboxPage from "./pages/combobox.react.tsx";
import TabsPage from "./pages/tabs.react.tsx";
import DisclosurePage from "./pages/disclosure.react.tsx";
import NavPage from "./pages/nav.react.tsx";
import ListPage from "./pages/list.react.tsx";
import TablePage from "./pages/table.react.tsx";
import ProgressPage from "./pages/progress.react.tsx";
import PopoverPage from "./pages/popover.react.tsx";
import DialogPage from "./pages/dialog.react.tsx";
import TooltipPage from "./pages/tooltip.react.tsx";
import ButtonFixturesPage from "./pages/button-fixtures.react.tsx";
import CheckboxFixturesPage from "./pages/checkbox-fixtures.react.tsx";
import ComboboxFixturesPage from "./pages/combobox-fixtures.react.tsx";
import DisclosureFixturesPage from "./pages/disclosure-fixtures.react.tsx";
import LayerFixturesPage from "./pages/layer-fixtures.react.tsx";
import ListFixturesPage from "./pages/list-fixtures.react.tsx";
import NavFixturesPage from "./pages/nav-fixtures.react.tsx";
import ProgressFixturesPage from "./pages/progress-fixtures.react.tsx";
import TableFixturesPage from "./pages/table-fixtures.react.tsx";
import TabsFixturesPage from "./pages/tabs-fixtures.react.tsx";
import { assertGalleryRoutes, GALLERY_SETTINGS, GALLERY_STORAGE_PREFIX, isGalleryPageId } from "./pages.ts";
import preview from "./preview.json";

// [...preview].astro owns the document shell, the title, global.css and the
// font. This entry only restores the settings and renders one island.
assertGalleryRoutes(preview.routes);

const route = Astro.locals.previewRoute;
invariant(
  route == null || isGalleryPageId(route),
  `Unknown Ariakit UI gallery route: ${route}`,
);

// Restores the persisted settings before the first paint, so the theme, the
// surface and the text size never flash. The render-blocking stylesheet in
// <head> holds the first paint until this has run, and shell.react.tsx writes
// the same keys and attributes. The names are interpolated rather than passed
// through define:vars, which declares variables the Astro type checker cannot
// see.
const restoreSettingsScript = `(() => {
  try {
    const root = document.documentElement;
    for (const name of ${JSON.stringify(GALLERY_SETTINGS)}) {
      const value = localStorage.getItem(${JSON.stringify(GALLERY_STORAGE_PREFIX)} + name);
      if (value) root.setAttribute("data-" + name, value);
    }
  } catch {}
})();`;
---

<script is:inline set:html={restoreSettingsScript} />

<!--
  Exactly one client:load island per route. withFramework treats the first
  island commit as a hydrated page, so a second island would race it, and
  test-routes-chrome.ts asserts the count.
-->
{route == null && <OverviewPage client:load />}
{route === "heading" && <HeadingPage client:load />}
{route === "prose" && <ProsePage client:load />}
{route === "separator" && <SeparatorPage client:load />}
{route === "code" && <CodePage client:load />}
{route === "kbd" && <KbdPage client:load />}
{route === "link" && <LinkPage client:load />}
{route === "button" && <ButtonPage client:load />}
{route === "badge" && <BadgePage client:load />}
{route === "input" && <InputPage client:load />}
{route === "checkbox" && <CheckboxPage client:load />}
{route === "radio" && <RadioPage client:load />}
{route === "combobox" && <ComboboxPage client:load />}
{route === "tabs" && <TabsPage client:load />}
{route === "disclosure" && <DisclosurePage client:load />}
{route === "nav" && <NavPage client:load />}
{route === "list" && <ListPage client:load />}
{route === "table" && <TablePage client:load />}
{route === "progress" && <ProgressPage client:load />}
{route === "popover" && <PopoverPage client:load />}
{route === "dialog" && <DialogPage client:load />}
{route === "tooltip" && <TooltipPage client:load />}
{route === "button-fixtures" && <ButtonFixturesPage client:load />}
{route === "checkbox-fixtures" && <CheckboxFixturesPage client:load />}
{route === "combobox-fixtures" && <ComboboxFixturesPage client:load />}
{route === "disclosure-fixtures" && <DisclosureFixturesPage client:load />}
{route === "layer-fixtures" && <LayerFixturesPage client:load />}
{route === "list-fixtures" && <ListFixturesPage client:load />}
{route === "nav-fixtures" && <NavFixturesPage client:load />}
{route === "progress-fixtures" && <ProgressFixturesPage client:load />}
{route === "table-fixtures" && <TableFixturesPage client:load />}
{route === "tabs-fixtures" && <TabsFixturesPage client:load />}
