// Astro renders static HTML and CSS without hydrating the React components.
// The sidebar starts closed in markup. An inline script restores a saved
// choice before paint and a plain button changes the body attribute.
import { Button } from "@ariakit/ui/components/button.ariakit.react";
import { Prose } from "@ariakit/ui/components/prose.ariakit.react";
import {
  Shell,
  ShellHeader,
  ShellHeaderCenter,
  ShellHeaderEnd,
  ShellHeaderStart,
  ShellMain,
  ShellSidebar,
} from "@ariakit/ui/components/shell.ariakit.react";

const sections = ["Introduction", "Installation", "Sidebars", "Centering"];
---

<Shell>
  <ShellHeader $blur>
    <ShellHeaderStart>
      <Button id="toggle" aria-expanded="false" aria-controls="sidebar">
        Toggle sidebar
      </Button>
      <strong>Static shell</strong>
    </ShellHeaderStart>
    <ShellHeaderCenter>Documentation</ShellHeaderCenter>
    <ShellHeaderEnd $shrink>No component JavaScript</ShellHeaderEnd>
  </ShellHeader>
  <ShellSidebar id="sidebar" open={false}>
    <nav aria-label="Documentation">
      <ul class="grid gap-1">
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.toLowerCase()}`} class="block px-3 py-2">
                {section}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </ShellSidebar>
  <ShellMain $centered>
    <Prose>
      <h1>Static shell</h1>
      {
        sections.map((section) => (
          <section>
            <h2 id={section.toLowerCase()}>{section}</h2>
            <p>
              The shell renders from its React components as static HTML and
              CSS. The header sticks, the sidebar folds and the main area stays
              centered without any component JavaScript.
            </p>
          </section>
        ))
      }
    </Prose>
  </ShellMain>
</Shell>

<script is:inline>
  const sidebar = document.getElementById("sidebar");
  const toggle = document.getElementById("toggle");
  if (sidebar && toggle) {
    const savedOpen = localStorage.getItem("shell-sidebar-open") === "true";
    sidebar.toggleAttribute("data-open", savedOpen);
    toggle.setAttribute("aria-expanded", String(savedOpen));
    toggle.addEventListener("click", () => {
      const open = sidebar.toggleAttribute("data-open");
      toggle.setAttribute("aria-expanded", String(open));
      localStorage.setItem("shell-sidebar-open", String(open));
    });
  }
</script>
