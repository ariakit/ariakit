// The shell from its React components, as an Astro page renders them: static
// HTML and CSS with a persisted open state and no component JavaScript,
// because nothing hydrates. Each component renders on its own, so the toggle
// is a plain button rather than a disclosure sharing the sidebar's store. The
// one script on the page flips the sidebar's open attribute the way a
// cookie-backed inline script would.
import { Button } from "@ariakit/ui/components/button.ariakit.react";
import { Prose } from "@ariakit/ui/components/prose.ariakit.react";
import {
  Shell,
  ShellHeader,
  ShellHeaderCenter,
  ShellHeaderEnd,
  ShellHeaderStart,
  ShellMain,
  ShellSidebar,
} from "@ariakit/ui/components/shell.ariakit.react";

const sections = ["Introduction", "Installation", "Sidebars", "Centering"];
---

<Shell $startWidth={64}>
  <ShellHeader $blur>
    <ShellHeaderStart>
      <Button id="toggle" aria-expanded="true" aria-controls="sidebar">
        Toggle sidebar
      </Button>
      <strong>Static shell</strong>
    </ShellHeaderStart>
    <ShellHeaderCenter>Documentation</ShellHeaderCenter>
    <ShellHeaderEnd $shrink>No component JavaScript</ShellHeaderEnd>
  </ShellHeader>
  <ShellSidebar id="sidebar">
    <nav aria-label="Documentation">
      <ul class="grid gap-1">
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.toLowerCase()}`} class="block px-3 py-2">
                {section}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </ShellSidebar>
  <ShellMain $centered>
    <Prose>
      <h1>Static shell</h1>
      {
        sections.map((section) => (
          <section>
            <h2 id={section.toLowerCase()}>{section}</h2>
            <p>
              The shell renders from its React components as static HTML and
              CSS. The header sticks, the sidebar folds and the main area stays
              centered without any component JavaScript.
            </p>
          </section>
        ))
      }
    </Prose>
  </ShellMain>
</Shell>

<script is:inline>
  // The plain toggle: the open state is one attribute on the column, so a
  // click flips it and the sidebar folds. Inline, so it ships as written: no
  // TypeScript syntax here.
  const column = document.getElementById("sidebar");
  const toggle = document.getElementById("toggle");
  if (column && toggle) {
    toggle.addEventListener("click", () => {
      const open = !column.hasAttribute("data-open");
      if (open) {
        column.setAttribute("data-open", "true");
      } else {
        column.removeAttribute("data-open");
      }
      toggle.setAttribute("aria-expanded", String(open));
    });
  }
</script>
