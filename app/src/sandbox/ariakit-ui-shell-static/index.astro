// Astro renders static HTML and CSS without hydrating the React components.
// The sidebar starts closed in markup. A plain button changes its recipe
// classes, as a page with cookie-backed state could do.
import { Button } from "@ariakit/ui/components/button.ariakit.react";
import { Prose } from "@ariakit/ui/components/prose.ariakit.react";
import {
  Shell,
  ShellHeader,
  ShellHeaderCenter,
  ShellHeaderEnd,
  ShellHeaderStart,
  ShellMain,
  ShellSidebar,
} from "@ariakit/ui/components/shell.ariakit.react";
import { shellSidebar } from "@ariakit/ui/styles/shell";

const sections = ["Introduction", "Installation", "Sidebars", "Centering"];
const openClassName = shellSidebar.jsx({ $open: true }).className;
const closedClassName = shellSidebar.jsx({ $open: false }).className;
---

<Shell>
  <ShellHeader $blur>
    <ShellHeaderStart>
      <Button id="toggle" aria-expanded="false" aria-controls="sidebar" data-open-class={openClassName} data-closed-class={closedClassName}>
        Toggle sidebar
      </Button>
      <strong>Static shell</strong>
    </ShellHeaderStart>
    <ShellHeaderCenter>Documentation</ShellHeaderCenter>
    <ShellHeaderEnd $shrink>No component JavaScript</ShellHeaderEnd>
  </ShellHeader>
  <ShellSidebar id="sidebar" $open={false}>
    <nav aria-label="Documentation">
      <ul class="grid gap-1">
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.toLowerCase()}`} class="block px-3 py-2">
                {section}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </ShellSidebar>
  <ShellMain $centered>
    <Prose>
      <h1>Static shell</h1>
      {
        sections.map((section) => (
          <section>
            <h2 id={section.toLowerCase()}>{section}</h2>
            <p>
              The shell renders from its React components as static HTML and
              CSS. The header sticks, the sidebar folds and the main area stays
              centered without any component JavaScript.
            </p>
          </section>
        ))
      }
    </Prose>
  </ShellMain>
</Shell>

<script is:inline>
  // The id belongs to the public body inside the folding column.
  const sidebar = document.getElementById("sidebar");
  const column = sidebar?.closest(".shell-sidebar");
  const toggle = document.getElementById("toggle");
  const openClassName = toggle?.getAttribute("data-open-class");
  const closedClassName = toggle?.getAttribute("data-closed-class");
  if (column && toggle && openClassName && closedClassName) {
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      column.className = open ? openClassName : closedClassName;
      toggle.setAttribute("aria-expanded", String(open));
    });
  }
</script>
