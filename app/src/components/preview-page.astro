// The page of a preview. It loads no app CSS entry point. The route pages that
// render it load global.css or sandbox.css. See getPreviewPagePaths.
import "@fontsource-variable/inter";
import ThemeScript from "#app/components/theme-script.astro";
import { previewEmbedScript } from "#app/lib/preview-embed-script.ts";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
  framework: CollectionEntry<"previews">["data"]["frameworks"][number];
  entry: CollectionEntry<"previews">;
  isolated: boolean;
}

const { framework, entry, isolated } = Astro.props;
const { Content } = await render(entry);

Astro.locals.framework = framework;
Astro.locals.previewIsolated = isolated;

const title = entry.data.title;
const fullscreen = entry.data.fullscreen;
// The embed script opens the popup of the preview when a card embeds it. An
// empty value opens it with a click.
const open = entry.data.open;
const openMode = open === "hover" ? "hover" : open ? "" : undefined;
// The embed script fits the frame to this element. An app shell fills the
// frame, and an open popup needs room before the frame can measure it, so those
// keep the fallback height of the card.
const contentSized = !fullscreen && !open;
---

<!doctype html>
<html lang="en" data-preview-open={openMode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>Preview {title} - Ariakit</title>
    <ThemeScript />
    {/* Runs before the preview renders, so focus calls on mount already
        respect an inactive preview card. */}
    <script is:inline set:html={previewEmbedScript} />
  </head>
  {/* The page leaves room below a short example, so a popup can open below
      its trigger. The body covers that room, so a click there is outside the
      popup, not on the root element that contains it. A compact page, such as
      in the navigation card, leaves no room, unless it opens a popup. See
      preview-embed.ts. */}
  <body
    class:list={[
      "flex",
      !fullscreen && [
        "flex-col",
        "[:root:not([data-preview-compact])_&]:min-h-[200vh]!",
        "[:root[data-preview-open]_&]:min-h-[200vh]!",
      ],
    ]}
  >
    {/* The framework island wraps the example and sizes to its content, so it
        needs a width limit for the example's own max-w-full to resolve. The
        example stays centered in the first viewport, with the same padding as
        an inline preview card. In a preview card, the bottom padding also
        leaves room for a horizontal scrollbar. See preview-embed.ts. The
        padding sides are separate utilities, because an ariakit-tailwind
        sandbox loads a second Tailwind build after the page CSS, and a p-8
        utility there would override the bottom padding. */}
    <div
      data-preview-content={contentSized ? "" : undefined}
      class:list={[
        "@container size-full",
        !fullscreen &&
          "min-h-dvh px-8 pt-8 pb-[calc(--spacing(8)+var(--preview-scrollbar-height,0px))] flex items-center-safe justify-center-safe *:max-w-full",
      ]}
    >
      <Content {framework} />
    </div>
  </body>
</html>
