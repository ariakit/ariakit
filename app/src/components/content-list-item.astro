import { listItem } from "@ariakit/ui/styles/list.ts";
import type { Polymorphic } from "astro/types";
import ContentListItemBody from "./content-list-item-body.astro";

type Props = Polymorphic<{ as: "li" }>;

const { as: Tag = "li", class: className, style, ...props } = Astro.props;

// Extract the slot html to check if it starts with a disabled checkbox
const children = await Astro.slots.render("default");

// Check for disabled checkbox (at root level or inside paragraph)
const checkboxRegex = /<input\s+[^>]*type=["']checkbox["'][^>]*disabled[^>]*>/i;
const match = children.match(checkboxRegex);

// The marker is absolutely positioned in the item's gutter, so the checkbox
// it stands in for is dropped from the body rather than replaced in place.
const body = match ? children.replace(checkboxRegex, "") : children;
const checked = match ? match[0].includes("checked") : undefined;
---

<Tag
  {...listItem.html({
    class: className,
    // Astro doesn't merge duplicate style attributes, so the caller style
    // goes through the cv, which merges it.
    style,
  })}
  {...props}
>
  {/* The half arc is the legacy unchecked task-item marker. A bare
      checked={false} would render an empty ring instead. */}
  <ContentListItemBody
    checked={checked}
    progress={checked === false ? 0.5 : undefined}
  >
    <Fragment set:html={body} />
  </ContentListItemBody>
</Tag>
