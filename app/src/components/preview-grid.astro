import { Frame } from "@ariakit/ui/components/frame.ariakit.react";
import { ShellMainFull } from "@ariakit/ui/components/shell.ariakit.react";
---

{/* Lays out preview cards in up to two columns, or one when two would be
    narrower than 24rem. A card with class="col-span-full" takes the whole
    row, and so does a card that would otherwise sit alone in its row. */}
<ShellMainFull>
  <Frame
    $p="var(--app-gutter)"
    className={[
      "preview-grid grid grid-cols-[repeat(auto-fill,minmax(min(100%,max(24rem,(100%-var(--preview-grid-gap))/2)),1fr))] gap-(--preview-grid-gap) py-0! [--preview-grid-gap:--spacing(8)]",
      // Cards keep their own heights. A shorter card sticks below the sticky
      // headers while a taller card in its row scrolls past. A sticky grid item
      // would stick through the whole grid, so the item stretches to its row
      // and the card inside it sticks.
      "[--preview-grid-top:calc(var(--shell-top)+var(--shell-head)+var(--shell-main-head,0px)+1rem)]",
      "*:*:sticky *:*:self-start *:*:top-(--preview-grid-top)",
      // A card within 20% of its row height grows to the row, so cards of
      // similar heights line up. Up to 30%, it grows less the shorter it is, so
      // a card follows its content, such as a closing disclosure, without a
      // jump. Browsers without calc-size() drop the declaration and keep the
      // card heights.
      "*:*:[min-height:calc-size(max-content,_max(size,_100%_-_3_*_max(0px,_100%_-_size_-_20%)))]",
      // A flexible row fills a card that grows to its minimum height, where an
      // auto row would keep its content height.
      "*:*:grid-rows-[1fr]",
      // A card that would sit alone in two columns takes the whole row: the
      // last card of a run between full-width cards, at an odd place in that
      // run. Runs of up to eight cards are counted. Every compound names the
      // card section: Astro can add a script before the cards, and a compound
      // without a type makes Chrome restyle the siblings of any element that is
      // added or removed anywhere on the page.
      // https://github.com/ariakit/ariakit/issues/7806
      "[&>section:not(.col-span-full):is(:last-of-type,:has(+section.col-span-full)):is(section:is(:first-of-type,.col-span-full+section),section:is(:first-of-type,.col-span-full+section):not(.col-span-full)+section:not(.col-span-full)+section,section:is(:first-of-type,.col-span-full+section):not(.col-span-full)+section:not(.col-span-full)+section:not(.col-span-full)+section:not(.col-span-full)+section,section:is(:first-of-type,.col-span-full+section):not(.col-span-full)+section:not(.col-span-full)+section:not(.col-span-full)+section:not(.col-span-full)+section:not(.col-span-full)+section:not(.col-span-full)+section)]:col-span-full",
      // The cards drop the band gutters, so the band needs no subgrid. Safari
      // places the card in only the first column of a subgrid that spans the
      // auto-filled columns.
      "*:grid-cols-1!",
      // A card fits on screen below the sticky headers, so a tall example
      // scrolls inside its card. The small viewport height does not change
      // while mobile browser toolbars collapse.
      // Short examples get the same minimum, so a row of small cards does not
      // look cramped. Inline previews elsewhere keep their own height.
      "[--preview-card-min-height:16rem]",
      "[--preview-card-max-height:calc(100svh-var(--preview-grid-top)-var(--shell-foot)-1rem)]",
    ].join(" ")}
  >
    <slot />
  </Frame>
</ShellMainFull>
