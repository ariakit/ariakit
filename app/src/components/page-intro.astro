import { Heading } from "@ariakit/ui/components/heading.ariakit.react";
import { Prose } from "@ariakit/ui/components/prose.ariakit.react";
import { AppBreadcrumb } from "#app/components/app-breadcrumb.react.tsx";
import type { AppTrail } from "#app/lib/trail.ts";

interface Props {
  title: string;
  /** The trail above the title. */
  trail?: AppTrail;
}

const { title, trail } = Astro.props;
---

{/* The trail stays outside the Prose, which adds space above a heading that
    follows other content. */}
<div class="flex min-w-0 flex-col gap-2">
  {trail && <AppBreadcrumb {trail} />}
  <Prose>
    <Heading>{title}</Heading>
    <slot />
  </Prose>
</div>
