import { heading } from "@ariakit/ui/styles/heading";
import { prose } from "@ariakit/ui/styles/prose";

interface Props {
  title: string;
}

const { title } = Astro.props;
const headingProps = heading.jsx({ className: "text-4xl tracking-tight" });
const proseProps = prose.jsx({ className: "ak-ink-75 text-lg" });
---

<h1 class={headingProps.className} style={headingProps.style}>{title}</h1>
{
  Astro.slots.has("default") && (
    <div class={proseProps.className} style={proseProps.style}>
      <slot />
    </div>
  )
}
