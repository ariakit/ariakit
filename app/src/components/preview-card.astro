import { Frame } from "@ariakit/ui/components/frame.ariakit.react";
import { ShellMainWide } from "@ariakit/ui/components/shell.ariakit.react";
import { TextFrame } from "@ariakit/ui/components/text-frame.ariakit.react";
import { PreviewCard } from "#app/components/preview-card.react.tsx";
import { isNextjsPreviewId } from "#app/lib/nextjs.ts";
import { PREVIEW_FRAME_MARGIN } from "#app/lib/preview-frames.ts";
import type { Framework } from "#app/lib/schemas.ts";
import type { Source } from "#app/lib/source.ts";
import { invariant } from "@ariakit/utils";
import { getEntry } from "astro:content";
import { createElement } from "react";

interface Props {
  source: Source | Partial<Record<Framework, Source>>;
  framework?: Framework;
  /**
   * Renders browser chrome above the preview, for previews that navigate
   * between routes. Defaults to `true` for Next.js previews.
   */
  browser?: boolean;
  /** Classes for the card band, such as `col-span-full` in a `PreviewGrid`. */
  class?: string;
  /**
   * Whether the card is in the page gallery. `remarkGalleryExamples` sets it
   * on the cards in `gallery.mdx` files.
   */
  gallery?: boolean;
}

const {
  source: sources,
  framework = Astro.locals.framework,
  class: className,
} = Astro.props;
invariant(framework, "Framework is required");
const source = "files" in sources ? sources : sources[framework];
if (!source) return null;
// A card in the page gallery is an example under the examples heading, and
// the table of contents links to it with the id that the layout picked.
// The section around the card takes the id, and the title links to it. A
// shorter card sticks below the headers while its grid row scrolls, so its
// title would leave the row, while the sections of a row share their top.
const galleryId = Astro.props.gallery
  ? Astro.locals.galleryIds?.get(source.name)
  : undefined;
// The table of contents would link to a missing id otherwise.
invariant(
  !Astro.props.gallery || galleryId,
  `The layout has no id for the gallery card ${source.name}`,
);
const preview = await getEntry("previews", source.name);
const title = preview?.data.title ?? source.name;
const href = "/" + framework + "/previews/" + source.name + "/";
const id = galleryId ?? "preview-card-" + source.name.replaceAll("/", "-");
const headingId = id + "-title";
const inline = Astro.slots.has("default");
const browser = !inline && (Astro.props.browser ?? isNextjsPreviewId(source.name));
const files = Object.entries(source.files);
---

{/* Astro renders the script once, at the first card. Before the card markup,
    it stays out of the run of sibling cards that preview grid selectors
    match. */}
<script>
  import { setupPreviewCardLinks } from "#app/lib/preview-card-links.ts";
  import { setupPreviewFrames } from "#app/lib/preview-frames.ts";

  setupPreviewFrames();
  setupPreviewCardLinks();
</script>

<ShellMainWide
  render={createElement("section", { id, "aria-labelledby": headingId })}
  {className}
>
  {/* Preview cards inside MDX prose or a preview grid are not main bands, so
      they drop the band gutter and align with the surrounding content. */}
  <Frame
    $p="var(--app-gutter)"
    className="grid grid-cols-1 py-0! [.prose>.shell-main-wide>&]:px-0! [.preview-grid>.shell-main-wide>&]:px-0!"
  >
    {/* The code renders on the server and reaches the island as a static
        slot. A card hydrates as it comes near the viewport, so an inline
        example, which hydrates after its card, starts as the person reaches
        it. Hydrating a little early lets a frame that loaded before its card
        hydrated show as the card scrolls into view, not after a loader. */}
    <PreviewCard
      client:visible={{ rootMargin: PREVIEW_FRAME_MARGIN }}
      sectionId={id}
      {headingId}
      headingLevel={galleryId ? 3 : 2}
      previewId={source.name}
      {title}
      {href}
      {inline}
      {browser}
      fullscreen={preview?.data.fullscreen}
      compact={preview?.data.compact}
    >
      {inline && <slot />}
      <div slot="code" class="grid grid-cols-1 gap-2">
        {
          files.map(([name, file]) => (
            <Frame
              $rounded="xl"
              $forceRounded
              $border
              $darken={0.5}
              $p="none"
              className="overflow-clip text-xs"
            >
              <TextFrame
                $p={3}
                $layer="transparent"
                $ink={80}
                className="font-medium"
              >
                {name}
              </TextFrame>
              <pre class="max-h-96 overflow-auto px-4 pb-4 leading-relaxed"><code>{file.content}</code></pre>
            </Frame>
          ))
        }
      </div>
    </PreviewCard>
  </Frame>
</ShellMainWide>
